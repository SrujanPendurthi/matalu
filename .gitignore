/target

# Tauri generated schemas (regenerated by tauri-build)
/src-tauri/gen/schemas
# MLX models are cached under ~/.cache/huggingface (not in-repo).
# Bundled/local model weights the sidecar loads offline (~1.2 GB) — never commit.
/sidecar/models/
# Legacy ONNX weights (pre-MLX switch), if present:
/nemotron
/nemotron_multi
/fullstr
# Python
__pycache__/
*.pyc
.venv/
# PyInstaller sidecar build artifacts (the staged binary overwrites the
# committed placeholder at src-tauri/binaries/ — don't commit the built binary).
/sidecar/build/
/sidecar/dist/
# Test/scratch audio
*.wav
*.aiff

# QLoRA training set — derived from DisfluencySpeech, rebuild with
# `python3 training/build_dataset.py` (7 MB, no reason to version it).
/training/data/
# Trained adapters: build artifacts of `mlx_lm.lora`, not source.
/sidecar/adapters/
